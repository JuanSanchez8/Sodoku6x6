<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="720.0" prefHeight="420.0" stylesheets="@styles.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-bar" BorderPane.alignment="CENTER">
            <children>
                <Label text="SUDOKU 6×6" styleClass="title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Fundamentos de Programación Orientada a Eventos" styleClass="subtitle"/>
            </children>
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        </HBox>
    </top>


    <center>
        <VBox alignment="CENTER" spacing="16">
            <children>
                <Label text="Ingresa tu nombre"/>
                <TextField fx:id="nicknameFieldStart" promptText="Tu apodo" prefWidth="260"/>
                <HBox alignment="CENTER" spacing="12">
                    <children>
                        <Button fx:id="buttonPlay" text="Jugar" defaultButton="true"/>
                        <Button fx:id="buttonHelpStart" text="¿Cómo jugar?"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>


    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="status-bar">
            <children>
                <Label text="MiniProyecto #2 · POE 750014C"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="v1.0"/>
            </children>
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
        </HBox>
    </bottom>


    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</BorderPane>