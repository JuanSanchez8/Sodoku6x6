<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="420.0" prefWidth="720.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.sodoku6x6.controller.StartController"
>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="title" text="SUDOKU 6×6" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label styleClass="subtitle" text="Fundamentos de Programación Orientada a Eventos" />
            </children>
            <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
        </HBox>
    </top>


    <center>
        <VBox alignment="CENTER" fillWidth="false" spacing="16">
            <children>
                <Label text="Bienvenido" maxWidth="Infinity" alignment="CENTER" textAlignment="CENTER"
                       style="-fx-font-size: 40px; -fx-font-weight: 800; -fx-text-fill: #111827;" />
                <HBox alignment="CENTER" spacing="12">
                    <children>
                        <Button fx:id="buttonPlay" defaultButton="true" text="Jugar" />
                        <Button fx:id="buttonHelpStart" text="¿Cómo jugar?" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>


    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="status-bar">
            <children>
                <Label text="MiniProyecto #2" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="v1.0" />
            </children>
            <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>
        </HBox>
    </bottom>


    <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
</BorderPane>
