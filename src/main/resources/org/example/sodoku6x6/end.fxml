<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="800.0" prefHeight="520.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" BorderPane.alignment="CENTER"
              style="-fx-background-color: linear-gradient(to bottom, #1f2937, #111827);">
            <children>
                <Label text="SUDOKU 6×6 — Fin de partida" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="MiniProyecto #2" style="-fx-text-fill: #d1d5db;"/>
            </children>
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        </HBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" spacing="18"
                      style="-fx-background-color: #F9FAFB; -fx-background-radius: 14; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0.1, 0, 4);">
                    <children>
                        <Label fx:id="labelEnd" text="¡Bien jugado!"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Has terminado el Sudoku 6×6" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>

                        <!-- Botones de acción -->
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Button fx:id="buttonAgain" text="Jugar de nuevo" defaultButton="true"
                                        style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-padding:8 14;"/>
                                <Button fx:id="buttonHome" text="Inicio"
                                        style="-fx-background-color:#F3F4F6; -fx-text-fill:#111827; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:8 14;"/>
                                <Button fx:id="buttonExit" text="Salir"
                                        style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-padding:8 14;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <children>
                <Label text="Gracias por jugar"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="POE 750014C · Univalle"/>
            </children>
            <padding><Insets top="8" right="12" bottom="8" left="8"/></padding>
        </HBox>
    </bottom>

    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
</BorderPane>